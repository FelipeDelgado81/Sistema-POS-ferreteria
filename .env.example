# Frontend
# En desarrollo local se puede omitir para usar /api como base URL.
VITE_API_URL=/api

# Supabase frontend publico (login con Supabase Auth desde el cliente).
# No usar la service role key en variables VITE_*.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_publica

# Backend / Vercel Functions
# La service role key se usa para datos y para verificar tokens de Supabase Auth.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_privada

# Los usuarios se crean en Supabase (Authentication -> Users).
# El rol (admin/seller) se define en app_metadata de cada usuario.
