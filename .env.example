# Frontend
# En desarrollo local se puede omitir para usar /api como base URL.
VITE_API_URL=/api

# Supabase frontend publico (solo cuando se use Supabase Auth o datos publicos desde cliente).
# No usar la service role key en variables VITE_*.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_publica

# Backend / Vercel Functions
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_privada
JWT_SECRET=cambia_este_secreto_en_produccion

# Usuarios temporales para auth propia simple.
# Reemplazar por Supabase Auth o gestion real de usuarios antes de produccion.
APP_USERS_JSON=[{"email":"admin@ferresys.cl","password":"admin123","name":"Administrador","role":"admin"},{"email":"ventas@ferresys.cl","password":"venta123","name":"Vendedor","role":"seller"}]
